# agentic-cli-status.service — systemd user unit for the rate-limit poller.
#
# Installed to ~/.config/systemd/user/ by install.sh and enabled for
# default.target so polling starts at login and keeps running. The poller
# re-reads its config every tick, so reconfiguration needs no restart.

[Unit]
Description=Agentic coding CLI rate-limit status poller

[Service]
Type=simple
ExecStart=%h/.local/bin/agentic-cli-status --daemon
EnvironmentFile=-%h/.config/agentic-cli-status/.env
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
